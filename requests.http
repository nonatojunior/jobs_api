# teste hello world
GET http://localhost:3000/ HTTP/1.1

###

# listar todos candidatos
GET http://localhost:3000/candidates HTTP/1.1

###

# criar um candidato
POST http://localhost:3000/candidates HTTP/1.1
content-type: application/json

{
  "name": "John Doe",
  "email": "john@email.com",
  "phone": "123456789",
  "bio": "Experienced software developer.",
  "openToWork": true
}

###

# atualizar um candidato
PUT http://localhost:3000/candidates/4 HTTP/1.1
content-type: application/json

{
  "name": "Mary Smith",
  "email": "mary@email.com",
  "phone": "987654321"
}

###

# visualizar um candidato
GET http://localhost:3000/candidates/6 HTTP/1.1

###

# deletar um candidato
DELETE http://localhost:3000/candidates/7 HTTP/1.1

###

# listar todas empresas
GET http://localhost:3000/companies HTTP/1.1

###

# criar uma empresa
POST http://localhost:3000/companies HTTP/1.1
content-type: application/json

{
  "name": "JR Code",
  "email": "jr@email.com",
  "bio": "Company software.",
  "website": "www.localhost.com"
}

###

# atualizar uma empresa
PUT http://localhost:3000/companies/4 HTTP/1.1
content-type: application/json

{
  "name": "JR Code 2026",
  "email": "jr_code_2026@email.com"
}

###

# visualizar uma empresa
GET http://localhost:3000/companies/4 HTTP/1.1

###

# deletar uma empresa
DELETE http://localhost:3000/companies/6 HTTP/1.1