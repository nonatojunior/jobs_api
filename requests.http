# teste hello world
GET http://localhost:3000/ HTTP/1.1

###

# lista todos candidatos
GET http://localhost:3000/candidates HTTP/1.1

###

# cria um candidato
POST http://localhost:3000/candidates HTTP/1.1
content-type: application/json

{
  "name": "John Doe",
  "email": "john@email.com",
  "phone": "123456789",
  "bio": "Experienced software developer.",
  "openToWork": true
}

###

# atualiza um candidato
PUT http://localhost:3000/candidates/4 HTTP/1.1
content-type: application/json

{
  "name": "Mary Smith",
  "email": "mary@email.com",
  "phone": "987654321"
}

###

# visualizar um candidato
GET http://localhost:3000/candidates/6 HTTP/1.1

###

# deletar um candidato
DELETE http://localhost:3000/candidates/7 HTTP/1.1

###

# lista todas empresas
GET http://localhost:3000/companies HTTP/1.1
